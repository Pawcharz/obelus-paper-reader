{
  "name": "paper-reader",
  "version": "0.1.0",
  "private": true,
  "description": "A pen-first reader for research papers on Windows: handwritten margin notes become text linked to what they refer to, kept as plain files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pawcharz/paper-reader.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "chokidar": "^6.0.0",
    "elkjs": "^0.12.1",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
